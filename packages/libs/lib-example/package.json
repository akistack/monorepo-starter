{
  "name": "@your-scope/lib-example",
  "version": "1.0.0",
  "description": "Example library package.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./es/*": {
      "types": "./dist/es/*.d.ts",
      "import": "./dist/es/*.js",
      "require": "./dist/es/*.cjs"
    }
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "format": "oxfmt --write",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware && oxfmt --write",
    "test": "rstest",
    "test:coverage": "npm run test -- --coverage",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@akistack/oxlint-config": "catalog:infra",
    "@akistack/tsconfig": "catalog:infra",
    "@rslib/core": "catalog:solution",
    "@rstest/adapter-rslib": "catalog:solution",
    "@rstest/core": "catalog:solution",
    "@rstest/coverage-v8": "catalog:solution",
    "@types/node": "catalog:infra",
    "oxfmt": "catalog:infra",
    "oxlint": "catalog:infra",
    "oxlint-tsgolint": "catalog:infra",
    "typescript": "catalog:infra"
  }
}
