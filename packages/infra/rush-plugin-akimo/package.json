{
  "name": "@akistack/rush-plugin-akimo",
  "version": "1.0.0",
  "description": "@akistack monorepo utils",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "akimo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build && NODE_ENV=development node ./dist/index.js",
    "dryrun": "DRYRUN=true npm run dev",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome format --write",
    "postinstall": "npm run build",
    "test": "vitest --run --passWithNoTests",
    "test:coverage": "npm run test -- --coverage",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "~8.2.0",
    "@rushstack/node-core-library": "5.19.1",
    "@rushstack/rush-sdk": "5.166.0",
    "commander": "~14.0.3",
    "@inquirer/core": "~11.1.1"
  },
  "devDependencies": {
    "@akistack/biome-config": "catalog:infra",
    "@akistack/tsconfig": "catalog:infra",
    "@biomejs/biome": "catalog:infra",
    "@rslib/core": "catalog:solution",
    "@types/node": "catalog:infra",
    "@types/react": "catalog:react",
    "@vitest/coverage-v8": "catalog:solution",
    "chalk": "~5.6.2",
    "ink": "~6.6.0",
    "ink-spinner": "~5.0.0",
    "react": "catalog:react",
    "typescript": "catalog:infra",
    "vitest": "catalog:solution",
    "@rsbuild/plugin-react": "catalog:solution"
  },
  "autor": "Aki"
}
