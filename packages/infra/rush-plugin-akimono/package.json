{
  "name": "@akistack/rush-plugin-akimono",
  "version": "1.0.0",
  "description": "@akistack monorepo utils",
  "bin": {
    "akimono": "dist/index.js"
  },
  "files": [
    "dist",
    "rush-plugin-manifest.json",
    "command-line.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rslib",
    "dev": "rslib && NODE_ENV=development node ./dist/index.js",
    "dryrun": "DRYRUN=true npm run dev",
    "format": "oxfmt --write",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware && oxfmt --write",
    "postinstall": "npm run build",
    "test": "rstest",
    "test:coverage": "npm run test -- --coverage",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/core": "~11.1.1",
    "@inquirer/prompts": "~8.2.0",
    "@rushstack/node-core-library": "5.19.1",
    "@rushstack/rush-sdk": "5.166.0",
    "commander": "~14.0.3",
    "ejs": "~4.0.1"
  },
  "devDependencies": {
    "@akistack/oxlint-config": "catalog:infra",
    "@akistack/tsconfig": "catalog:infra",
    "@rsbuild/plugin-react": "catalog:solution",
    "@rslib/core": "catalog:solution",
    "@rstest/adapter-rslib": "catalog:solution",
    "@rstest/core": "catalog:solution",
    "@rstest/coverage-v8": "catalog:solution",
    "@types/ejs": "~3.1.5",
    "@types/node": "catalog:infra",
    "@types/react": "catalog:react",
    "chalk": "~5.6.2",
    "ink": "~6.6.0",
    "ink-spinner": "~5.0.0",
    "oxfmt": "catalog:infra",
    "oxlint": "catalog:infra",
    "oxlint-tsgolint": "catalog:infra",
    "react": "catalog:react",
    "typescript": "catalog:infra"
  },
  "autor": "Aki"
}
