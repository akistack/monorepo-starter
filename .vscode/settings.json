{
  "files.associations": {
    // Use `JSON with Comments` for Rush configuration files
    "rush.json": "jsonc",
    "**/common/config/rush/*.json": "jsonc"
  },
  // Linting & formatting
  "oxc.path.oxlint": "./common/autoinstallers/infra/node_modules/.bin/oxlint",
  "oxc.path.oxfmt": "./common/autoinstallers/infra/node_modules/.bin/oxfmt",
  "oxc.path.tsgolint": "./common/autoinstallers/infra/node_modules/.bin/tsgolint",
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.format.oxc": "explicit",
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.format.oxc": "explicit",
      "source.fixAll.oxc": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.format.oxc": "explicit",
      "source.fixAll.oxc": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": false
  },
  // Tailwind CSS
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.classFunctions": [
    "tw",
    "clsx",
    "tw\\.[a-z-]+"
  ]
}